#!/bin/sh

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
	purge)
		# Activate trigger to rebuild workbench configuration files.
		dpkg-trigger update-workbench
		# Remove the configuration data. The database model has already
		# been removed at this stage, so the helper tools are used.
		echo "Cleaning up configuration database ..."
		omv_config_delete "/config/services/iscsitarget"
	;;

	remove)
		dpkg-trigger update-workbench
	;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

#DEBHELPER#

exit 0
