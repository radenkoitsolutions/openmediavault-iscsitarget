[
	{
		"type": "rpc",
		"id": "rpc.iscsitarget.setsettings",
		"params": {
			"type": "object",
			"properties": {
				"enable": {
					"type": "boolean",
					"required": true
				},
				"basename": {
					"type": "string",
					"pattern": "^iqn\\.[0-9]{4}-[0-9]{2}\\.[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
					"required": true
				},
				"address": {
					"type": "string",
					"pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$",
					"required": true
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535,
					"required": true
				}
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.iscsitarget.setlun",
		"params": {
			"type": "object",
			"properties": {
				"uuid": {
					"type": "string",
					"format": "uuidv4",
					"required": true
				},
				"name": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]{1,64}$",
					"required": true
				},
				"sharedfolderref": {
					"type": "string",
					"format": "uuidv4",
					"required": true
				},
				"filename": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,254}$",
					"required": true
				},
				"size": {
					"type": "integer",
					"minimum": 1,
					"required": true
				},
				"writeback": {
					"type": "boolean",
					"required": true
				},
				"unmap": {
					"type": "boolean",
					"required": true
				},
				"comment": {
					"type": "string",
					"required": true
				}
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.iscsitarget.settarget",
		"params": {
			"type": "object",
			"properties": {
				"uuid": {
					"type": "string",
					"format": "uuidv4",
					"required": true
				},
				"enable": {
					"type": "boolean",
					"required": true
				},
				"name": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9.:-]{0,191}$",
					"required": true
				},
				"luns": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuidv4"
					},
					"required": true
				},
				"initiators": {
					"type": "string",
					"required": true
				},
				"authentication": {
					"type": "string",
					"enum": [
						"none",
						"chap"
					],
					"required": true
				},
				"userid": {
					"type": "string",
					"required": true
				},
				"password": {
					"type": "string",
					"required": true
				},
				"mutualuserid": {
					"type": "string",
					"required": true
				},
				"mutualpassword": {
					"type": "string",
					"required": true
				},
				"comment": {
					"type": "string",
					"required": true
				}
			}
		}
	}
]
